# Copy this file to .env.local (git-ignored) and fill in real values.
# Never commit .env.local, and never set these as NEXT_PUBLIC_ — both
# are server-only secrets, read only in app/api/subscribe/route.ts.

# Resend API key (resend.com/api-keys). Required.
RESEND_API_KEY=

# Resend Segment id to add new subscribers to (resend.com's dashboard,
# under Audiences/Segments — Audiences were recently renamed Segments).
# Required — there is no default. This needs a ONE-TIME MANUAL STEP
# before the endpoint works at all: create a Segment in the Resend
# dashboard, then paste its id here. Without it, app/api/subscribe
# fails closed by design (a 500 "Subscription temporarily unavailable"),
# so an empty value here is expected to produce that 500 on first local
# test — it is not a bug.
RESEND_SEGMENT_ID=
